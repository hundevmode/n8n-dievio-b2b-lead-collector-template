    {
      "parameters": {
        "jsCode": "const response = $json;\nconst ctx = $('Fetch Dievio Leads').first().json;\nconst rows = Array.isArray(response?.preview_data) ? response.preview_data : [];\n\nconst leads = rows.slice(0, ctx.config.maxResults).map((lead) => ({\n  request_id: ctx.requestId,\n  collected_at: new Date().toISOString(),\n  first_name: lead.first_name ?? '',\n  last_name: lead.last_name ?? '',\n  full_name: lead.full_name ?? [lead.first_name, lead.last_name].filter(Boolean).join(' '),\n  job_title: lead.job_title ?? '',\n  company: lead.company ?? '',\n  city: lead.city ?? '',\n  state: lead.state ?? '',\n  country: lead.country ?? '',\n  work_email: lead.work_email ?? '',\n  personal_emails: Array.isArray(lead.personal_emails) ? lead.personal_emails.join(', ') : (lead.personal_emails ?? ''),\n  email_status: lead.email_status ?? '',\n  mobile_phone: lead.mobile_phone ?? '',\n  phone_status: lead.phone_status ?? '',\n  linkedin_url: lead.linkedin_url ?? '',\n  linkedin_status: lead.linkedin_status ?? '',\n  twitter_status: lead.twitter_status ?? '',\n  facebook_status: lead.facebook_status ?? ''\n}));\n\nreturn [{\n  json: {\n    ok: true,\n    requestId: ctx.requestId,\n    config: ctx.config,\n    pagesFetched: 1,\n    leadsCount: leads.length,\n    leads\n  }\n}];"
      },
