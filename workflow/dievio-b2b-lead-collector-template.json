      "parameters": {
        "jsCode": "const payload = $json.body ?? $json;\n\nfunction asBool(v, fallback) {\n  if (v === undefined || v === null || v === '') return fallback;\n  if (typeof v === 'boolean') return v;\n  if (typeof v === 'number') return v !== 0;\n  if (typeof v === 'string') return ['1','true','yes','y','on'].includes(v.toLowerCase().trim());\n  return fallback;\n}\n\nfunction asInt(v, fallback, min, max) {\n  const n = Number.parseInt(v, 10);\n  if (!Number.isFinite(n)) return fallback;\n  return Math.max(min, Math.min(max, n));\n}\n\nconst spreadsheetId = payload.spreadsheetId || payload.sheetId || payload.googleSheets?.spreadsheetId || '';\nconst sheetName = payload.sheetName || payload.googleSheets?.sheetName || 'Leads';\n\nconst config = {\n  endpoint: payload.endpoint || 'https://dievio.com/api/public/search',\n  perPage: asInt(payload.perPage ?? payload._per_page, 100, 1, 1000),\n  maxResults: asInt(payload.maxResults ?? payload.max_results, 1000, 1, 100000),\n  includeEmails: asBool(payload.includeEmails, true),\n  includePhones: asBool(payload.includePhones, false),\n  emailStatus: (payload.emailStatus || 'all').toString().toLowerCase(),\n  includeRaw: asBool(payload.includeRaw ?? payload._include_raw, false),\n  filters: (payload.filters && typeof payload.filters === 'object' && !Array.isArray(payload.filters)) ? payload.filters : {},\n  googleSheets: {\n    spreadsheetId,\n    sheetName\n  }\n};\n\nif (!config.googleSheets.spreadsheetId) {\n  return [{\n    json: {\n      ok: false,\n      error: 'Missing Google Spreadsheet ID',\n      hint: 'Send spreadsheetId in the request body.'\n    }\n  }];\n}\n\nconst validEmailStatus = ['all', 'verified', 'likely'];\nif (!validEmailStatus.includes(config.emailStatus)) {\n  return [{\n    json: {\n      ok: false,\n      error: 'Invalid emailStatus',\n      hint: 'Use one of: all, verified, likely.'\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    ok: true,\n    requestId: 'dievio-' + Date.now(),\n    config\n  }\n}];"
      },
